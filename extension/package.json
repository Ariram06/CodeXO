{
  "name": "codexo-extension",
  "version": "0.1.0",
  "description": "Codexo Chrome Extension - Progressive DSA hints",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "generate-icons": "node scripts/generate-icons.mjs",
    "build:sidepanel": "ng build --configuration production",
    "build:extension": "node scripts/build-extension.mjs",
    "build:copy-manifest": "node -e \"const fs=require('fs');fs.cpSync('public/manifest.json','dist/codexo/manifest.json');fs.cpSync('public/icons','dist/codexo/icons',{recursive:true,force:true})\"",
    "build": "npm run generate-icons && npm run build:sidepanel && npm run build:extension && npm run build:copy-manifest",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "package": "npm run build && node scripts/package-extension.mjs"
  },
  "private": true,
  "packageManager": "npm@11.8.0",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "dompurify": "^3.4.18",
    "katex": "^0.19.1",
    "marked": "^18.2.1",
    "prismjs": "^1.30.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.29",
    "@angular/cli": "^21.2.29",
    "@angular/compiler-cli": "^21.2.0",
    "@types/chrome": "^0.3.7",
    "@types/dompurify": "^3.0.5",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.6",
    "@types/prismjs": "^1.26.6",
    "esbuild": "^0.25.12",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "sharp": "^0.35.5",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
