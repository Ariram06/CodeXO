{
  "name": "codexo-extension",
  "version": "0.1.0",
  "description": "Codexo Chrome Extension - Progressive DSA hints",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build:sidepanel": "ng build --configuration production",
    "build:extension": "node scripts/build-extension.mjs",
    "build:copy-manifest": "node -e \"const fs=require('fs');fs.cpSync('public/manifest.json','dist/codexo/manifest.json');fs.cpSync('public/icons','dist/codexo/icons',{recursive:true,force:true})\"",
    "build": "npm run build:sidepanel && npm run build:extension && npm run build:copy-manifest",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "npm@11.8.0",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.29",
    "@angular/cli": "^21.2.29",
    "@angular/compiler-cli": "^21.2.0",
    "@types/chrome": "^0.3.7",
    "esbuild": "^0.25.12",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
