{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "CodexoApi",
    "Audience": "CodexoExtension",
    "ExpiryMinutes": 60
  },
  "AI": {
    "Provider": "Fake",
    "BaseUrl": "https://generativelanguage.googleapis.com/v1beta/openai/",
    "Model": "gemini-3.5-flash-lite",
    "TimeoutSeconds": 60,
    "MaxTokens": 2000,
    "ReasoningEffort": "low",
    "Temperature": 0.2
  },
  "RateLimiting": {
    "PermitLimitPerMinute": 20,
    "PermitLimitPerDay": 200
  }
}
